{
  "name": "general-basic-table",
  "version": "3.0.2",
  "description": "",
  "main": "./dist/index.umd.cjs",
  "type": "module",
  "scripts": {
    "build": "cross-env CURRENT_ENV=prod run-p type-check && run-p build-only",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "type-check": "tsc --noEmit -p tsconfig.json --composite false",
    "link": "tsx script/link.ts && yarn link",
    "unlink": "tsx script/unlinkModule.ts && yarn unlink && run-p build",
    "linkNode": "tsx script/linkNode.ts && yarn link && run-p dev",
    "unlinkNode": "tsx script/unlinkNode.ts && yarn unlink && run-p buildts",
    "dev": "tsc -w -p .",
    "buildts": "rimraf dist && tsc -p ."
  },
  "keywords": [
    "table",
    "general",
    "general-basic-table",
    "vue3",
    "vue2",
    "react",
    "element-plus",
    "element-ui",
    "shadcn/ui",
    "shadcn",
    "@xgent/ui-shadcn"
  ],
  "author": "chendeli419287484@qq.com",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/Alan1034/GeneralBasicTable.git"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@vitejs/plugin-legacy": "^7.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "chalk": "^5.6.2",
    "cross-env": "^10.1.0",
    "less": "^4.4.2",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.0.1",
    "sass-embedded": "^1.93.2",
    "svgo": "^4.0.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vite-plugin-image-optimizer": "^2.0.2",
    "vite-plugin-javascript-obfuscator": "^3.1.0"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "typings": "./dist/index.d.ts",
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "tailwind-merge": "^3.3.1"
  },
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    },
    "./style": "./dist/index.css"
  },
  "files": [
    "/dist"
  ]
}